FROM rust:1.97.1-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        clang \
        cmake \
        libasound2-dev \
        libgl1-mesa-dev \
        libudev-dev \
        libv4l-dev \
        libwayland-dev \
        libxkbcommon-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN rustup component add rustfmt clippy

WORKDIR /workspace

CMD ["bash", "-c", "cargo fmt --check && cargo check --locked && cargo test --locked && cargo clippy --locked --all-targets --all-features"]
