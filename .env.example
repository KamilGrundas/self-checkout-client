DEFAULT_LANG=en
APP_ENV=dev
API_BASE_URL=http://localhost:8000
ML_API_BASE_URL=http://localhost:8001
# Optional on macOS; the client also checks PATH and standard Homebrew paths.
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# Created with the checkout counter in the admin panel; never commit real values.
CHECKOUT_API_KEY=replace-with-counter-api-key
